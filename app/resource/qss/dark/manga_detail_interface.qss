QWidget#mangaTagGroups,
QWidget#mangaTagGroup,
QWidget#mangaTagChipContainer {
    background: transparent;
}

QLabel#mangaTagGroupTitle {
    color: rgba(255, 255, 255, 165);
    font-size: 12px;
    font-weight: 600;
}

QLabel#mangaTagEmptyLabel {
    color: rgba(255, 255, 255, 125);
}

QLabel#galleryVersionStatus[versionState="outdated"] {
    color: #f2b45f;
    font-weight: 600;
}

QLabel#galleryVersionStatus[versionState="current"] {
    color: #8fd694;
}

QLabel#galleryQualityBadge {
    min-height: 22px;
    padding: 1px 9px;
    border: 1px solid #5f6268;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#galleryQualityBadge[qualityTone="full"] {
    border-color: #d1a744;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #d9b74d, stop: 0.34 #c65dab,
        stop: 0.67 #4aaeba, stop: 1 #d9b74d);
    color: #1f1727;
}

QLabel#galleryQualityBadge[qualityTone="original"] {
    border-color: #8e6d28;
    background: rgba(205, 154, 49, 42);
    color: #efc865;
}

QLabel#galleryQualityBadge[qualityTone="base"] {
    border-color: #7455a2;
    background: rgba(139, 92, 201, 45);
    color: #c9a8f4;
}

QLabel#mangaTagChip {
    min-height: 24px;
    padding: 1px 9px;
    border: 1px solid #5f6268;
    border-radius: 5px;
    background: rgba(255, 255, 255, 18);
    color: #d7d9de;
    font-size: 12px;
}

QLabel#mangaTagChip[tagTone="creator"] {
    border-color: #315f89;
    background: rgba(51, 126, 204, 35);
    color: #79bbff;
}

QLabel#mangaTagChip[tagTone="work"] {
    border-color: #634d91;
    background: rgba(118, 83, 184, 38);
    color: #bda6eb;
}

QLabel#mangaTagChip[tagTone="language"] {
    border-color: #466b38;
    background: rgba(82, 155, 46, 35);
    color: #95d475;
}

QLabel#mangaTagChip[tagTone="female"] {
    border-color: #814563;
    background: rgba(185, 74, 125, 38);
    color: #e79aba;
}

QLabel#mangaTagChip[tagTone="male"] {
    border-color: #346b78;
    background: rgba(23, 130, 155, 38);
    color: #70c7d8;
}

QLabel#mangaTagChip[tagTone="mixed"] {
    border-color: #7d6238;
    background: rgba(184, 130, 48, 38);
    color: #e6b980;
}

QWidget#onlineCommentsList,
QWidget#onlineCommentRow {
    background: transparent;
}

QLabel#onlineCommentAuthor {
    color: #f1f2f4;
    font-weight: 600;
}

QLabel#onlineCommentsCount,
QLabel#onlineCommentMeta,
QLabel#onlineCommentsStatus {
    color: rgba(255, 255, 255, 135);
}

QLabel#onlineCommentUploaderBadge {
    padding: 1px 6px;
    border: 1px solid #466b38;
    border-radius: 4px;
    background: rgba(82, 155, 46, 35);
    color: #95d475;
}

QLabel#onlineCommentScore[scoreTone="positive"] {
    color: #83cf94;
}

QLabel#onlineCommentScore[scoreTone="negative"] {
    color: #e89a9a;
}

QFrame#onlineCommentSeparator {
    color: #4a4d53;
    background: #4a4d53;
    max-height: 1px;
}
