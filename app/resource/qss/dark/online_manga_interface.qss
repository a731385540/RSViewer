QWidget#onlineMangaInterface,
QWidget#onlineMangaScrollWidget,
QWidget#onlineMangaScrollViewport {
    background: transparent;
}

QScrollArea#onlineMangaScrollArea {
    border: none;
    background: transparent;
}

QWidget#onlineGalleryCard,
QWidget#onlineGalleryListCard,
QWidget#onlineGalleryExtendedCard {
    background: rgba(255, 255, 255, 10);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
}

QWidget#onlineGalleryCard[galleryMarked="true"],
QWidget#onlineGalleryListCard[galleryMarked="true"],
QWidget#onlineGalleryExtendedCard[galleryMarked="true"] {
    border: 3px solid #7f1d1d;
}

QLabel#onlineGalleryCover {
    background: #292b2f;
    border: 1px solid #3b3e44;
    border-radius: 6px;
    color: rgba(255, 255, 255, 135);
}

QLabel#onlineGalleryDownloadedBadge {
    background: rgba(24, 25, 28, 225);
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 7px;
}

QLabel#onlineGalleryRating,
QLabel#onlineGalleryPosted,
QLabel#onlineGalleryUploader,
QLabel#onlineGalleryPageCount {
    padding: 0;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 205);
}

QLabel#onlineGalleryTitleCell {
    padding: 0;
    background: transparent;
    border: none;
    color: #f2f2f2;
}

QLabel#onlineGalleryListTitle {
    padding: 0;
    background: transparent;
    border: none;
    color: #f2f2f2;
    font-size: 14px;
    font-weight: 600;
}

QLabel#onlineGalleryCategory {
    min-width: 86px;
    max-width: 86px;
    min-height: 18px;
    max-height: 18px;
    padding: 0;
    border-radius: 2px;
    color: white;
    font-weight: 600;
}

QLabel#onlineGalleryCategory[categoryStyle="ct1"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #707070, stop:1 #9e9e9e);
    border: 1px solid #707070;
}

QLabel#onlineGalleryCategory[categoryStyle="ct2"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #fc4e4e, stop:1 #f26f5f);
    border: 1px solid #fc4e4e;
}

QLabel#onlineGalleryCategory[categoryStyle="ct3"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #e78c1a, stop:1 #fcb417);
    border: 1px solid #e78c1a;
}

QLabel#onlineGalleryCategory[categoryStyle="ct4"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #c7bf07, stop:1 #dde500);
    border: 1px solid #c7bf07;
}

QLabel#onlineGalleryCategory[categoryStyle="ct5"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #1a9317, stop:1 #05bf0b);
    border: 1px solid #1a9317;
}

QLabel#onlineGalleryCategory[categoryStyle="ct6"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #2756aa, stop:1 #5f5fff);
    border: 1px solid #2756aa;
}

QLabel#onlineGalleryCategory[categoryStyle="ct7"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #8800c3, stop:1 #9755f5);
    border: 1px solid #8800c3;
}

QLabel#onlineGalleryCategory[categoryStyle="ct8"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #b452a5, stop:1 #fe93ff);
    border: 1px solid #b452a5;
}

QLabel#onlineGalleryCategory[categoryStyle="ct9"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #0f9ebd, stop:1 #08d7e2);
    border: 1px solid #0f9ebd;
}

QLabel#onlineGalleryCategory[categoryStyle="cta"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #5dc13b, stop:1 #14e723);
    border: 1px solid #5dc13b;
}

QLabel#onlineGalleryCategory[categoryStyle="private"] {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #333333, stop:1 #666666);
    border: 1px solid #333333;
}

QLabel#onlineGalleryCategory[categoryStyle="unknown"] {
    background: #777777;
    border: 1px solid #929292;
}

QLabel#onlineGalleryExtendedTitle {
    color: #f2f2f2;
    font-size: 14px;
    font-weight: 600;
}

QLabel#onlineGalleryTagChip {
    padding: 3px 7px;
    background: rgba(255, 255, 255, 7);
    border: 1px solid rgba(255, 255, 255, 19);
    border-radius: 8px;
    color: rgba(255, 255, 255, 205);
}

QLabel#onlineGalleryTagsPlaceholder,
QLabel#onlineGalleryExtendedMeta {
    color: rgba(255, 255, 255, 135);
}
