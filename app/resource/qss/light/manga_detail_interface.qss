QWidget#mangaTagGroups,
QWidget#mangaTagGroup,
QWidget#mangaTagChipContainer {
    background: transparent;
}

QLabel#mangaTagGroupTitle {
    color: rgba(0, 0, 0, 150);
    font-size: 12px;
    font-weight: 600;
}

QLabel#mangaTagEmptyLabel {
    color: rgba(0, 0, 0, 115);
}

QLabel#galleryVersionStatus[versionState="outdated"] {
    color: #b54708;
    font-weight: 600;
}

QLabel#galleryVersionStatus[versionState="current"] {
    color: #2f7d32;
}

QLabel#galleryQualityBadge {
    min-height: 22px;
    padding: 1px 9px;
    border: 1px solid #d0d3d8;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#galleryQualityBadge[qualityTone="full"] {
    border-color: #c99535;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #f4cf62, stop: 0.34 #e98acb,
        stop: 0.67 #79d3df, stop: 1 #f4cf62);
    color: #30233a;
}

QLabel#galleryQualityBadge[qualityTone="original"] {
    border-color: #d3a33d;
    background: #fff4cf;
    color: #8a5a00;
}

QLabel#galleryQualityBadge[qualityTone="base"] {
    border-color: #b89ae8;
    background: #f4edff;
    color: #7145ad;
}

QLabel#mangaTagChip, QLabel#mangaKeyTagChip {
    min-height: 24px;
    padding: 1px 9px;
    border: 1px solid #dcdfe6;
    border-radius: 5px;
    background: #f4f4f5;
    color: #606266;
    font-size: 12px;
}

QLabel#mangaTagChip[tagTone="creator"], QLabel#mangaKeyTagChip[tagTone="creator"] {
    border-color: #b3d8ff;
    background: #ecf5ff;
    color: #337ecc;
}

QLabel#mangaTagChip[tagTone="work"], QLabel#mangaKeyTagChip[tagTone="work"] {
    border-color: #cbb9f4;
    background: #f4efff;
    color: #7653b8;
}

QLabel#mangaTagChip[tagTone="language"], QLabel#mangaKeyTagChip[tagTone="language"] {
    border-color: #b3e19d;
    background: #f0f9eb;
    color: #529b2e;
}

QLabel#mangaTagChip[tagTone="female"], QLabel#mangaKeyTagChip[tagTone="female"] {
    border-color: #f3b7d3;
    background: #fdf2f8;
    color: #b94a7d;
}

QLabel#mangaTagChip[tagTone="male"], QLabel#mangaKeyTagChip[tagTone="male"] {
    border-color: #a5e4ef;
    background: #ecfbfe;
    color: #17829b;
}

QLabel#mangaTagChip[tagTone="mixed"], QLabel#mangaKeyTagChip[tagTone="mixed"] {
    border-color: #f3d19e;
    background: #fdf6ec;
    color: #b88230;
}

QWidget#onlineCommentsList,
QWidget#onlineCommentRow {
    background: transparent;
}

QLabel#onlineCommentAuthor {
    color: #1f2329;
    font-weight: 600;
}

QLabel#onlineCommentsCount,
QLabel#onlineCommentMeta,
QLabel#onlineCommentsStatus {
    color: rgba(0, 0, 0, 125);
}

QLabel#onlineCommentUploaderBadge {
    padding: 1px 6px;
    border: 1px solid #95d475;
    border-radius: 4px;
    background: #f0f9eb;
    color: #3f8f27;
}

QLabel#onlineCommentScore[scoreTone="positive"] {
    color: #2f8f46;
}

QLabel#onlineCommentScore[scoreTone="negative"] {
    color: #c45656;
}

QFrame#onlineCommentSeparator {
    color: #e4e7ed;
    background: #e4e7ed;
    max-height: 1px;
}
