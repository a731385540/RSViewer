QWidget#mangaTagGroups,
QWidget#mangaTagGroup,
QWidget#mangaTagChipContainer {
    background: transparent;
}

QLabel#mangaTagGroupTitle {
    color: rgba(0, 0, 0, 150);
    font-size: 12px;
    font-weight: 600;
}

QLabel#mangaTagEmptyLabel {
    color: rgba(0, 0, 0, 115);
}

QLabel#mangaTagChip {
    min-height: 24px;
    padding: 1px 9px;
    border: 1px solid #dcdfe6;
    border-radius: 5px;
    background: #f4f4f5;
    color: #606266;
    font-size: 12px;
}

QLabel#mangaTagChip[tagTone="creator"] {
    border-color: #b3d8ff;
    background: #ecf5ff;
    color: #337ecc;
}

QLabel#mangaTagChip[tagTone="work"] {
    border-color: #cbb9f4;
    background: #f4efff;
    color: #7653b8;
}

QLabel#mangaTagChip[tagTone="language"] {
    border-color: #b3e19d;
    background: #f0f9eb;
    color: #529b2e;
}

QLabel#mangaTagChip[tagTone="female"] {
    border-color: #f3b7d3;
    background: #fdf2f8;
    color: #b94a7d;
}

QLabel#mangaTagChip[tagTone="male"] {
    border-color: #a5e4ef;
    background: #ecfbfe;
    color: #17829b;
}

QLabel#mangaTagChip[tagTone="mixed"] {
    border-color: #f3d19e;
    background: #fdf6ec;
    color: #b88230;
}
